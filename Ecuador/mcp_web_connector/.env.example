# ── MCP Web Connector — Ecuador ──────────────────────────────────────────────
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a git.

# ── SSH ──────────────────────────────────────────────────────────────────────
MCP_WEB_SSH_HOST=51.79.104.194
MCP_WEB_SSH_PORT=22
MCP_WEB_SSH_USER=root

# Usa contraseña O llave privada (no ambas).
# Contraseña:
MCP_WEB_SSH_PASSWORD=

# Llave privada (ruta absoluta al archivo .pem / id_rsa / id_ed25519):
# MCP_WEB_SSH_KEY_FILE=/Users/tu_usuario/.ssh/id_rsa_ecuador

# Host key para verificación estricta (recomendado).
# Obtén el valor ejecutando la skill get_server_host_key() del MCP,
# o: ssh-keyscan -t ed25519 51.79.104.194
# Formato: "ssh-ed25519 AAAA..."
MCP_WEB_SSH_KNOWN_HOST_KEY=

# ── Rutas permitidas en el servidor ──────────────────────────────────────────
# En cPanel: /home/<usuario_cpanel>/public_html
# Ajusta al usuario real de cPanel de Ecuador.
MCP_WEB_ALLOWED_ROOTS=/home,/var/www,/usr/local/apache/htdocs

# ── Límite de lectura de archivos ─────────────────────────────────────────────
MCP_WEB_MAX_READ_BYTES=100000

# ── Base de datos (opcional — completar solo si Ecuador usa MariaDB) ──────────
# MCP_WEB_DB_HOST=127.0.0.1
# MCP_WEB_DB_PORT=3306
# MCP_WEB_DB_NAME=
# MCP_WEB_DB_USER=
# MCP_WEB_DB_PASSWORD=
