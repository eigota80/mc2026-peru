# ── MCP Web Connector — Ecuador ──────────────────────────────────────────────
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env a git.

# ── SSH ──────────────────────────────────────────────────────────────────────
MCP_WEB_SSH_HOST=hc-02.webserver.ec
MCP_WEB_SSH_PORT=22
MCP_WEB_SSH_USER=mediaco2

# Llave privada SSH (ruta absoluta)
# La llave pública debe estar autorizada en cPanel → SSH Access para mediaco2
MCP_WEB_SSH_KEY_FILE=/Users/eidergonzaleztamara/.ssh/mc2026/mcecuador-mediaco2

# Host key para verificación estricta (recomendado).
# Ejecutar la skill get_server_host_key() del MCP una vez conectado,
# o: ssh-keyscan -t ed25519 hc-02.webserver.ec
# Formato: "ssh-ed25519 AAAA..."
MCP_WEB_SSH_KNOWN_HOST_KEY=

# ── Rutas permitidas en el servidor ──────────────────────────────────────────
# Web root cPanel del usuario mediaco2
MCP_WEB_ALLOWED_ROOTS=/home/mediaco2/public_html,/home/mediaco2,/home

# ── Límite de lectura de archivos ─────────────────────────────────────────────
MCP_WEB_MAX_READ_BYTES=100000

# ── Base de datos (no configurada para Ecuador) ───────────────────────────────
# MCP_WEB_DB_HOST=127.0.0.1
# MCP_WEB_DB_PORT=3306
# MCP_WEB_DB_NAME=
# MCP_WEB_DB_USER=
# MCP_WEB_DB_PASSWORD=
