# MCP Web Connector - ejemplo sin secretos
MCP_WEB_SSH_HOST=179.43.82.54
MCP_WEB_SSH_PORT=22
MCP_WEB_SSH_USER=mcp-agent
MCP_WEB_SSH_KEY_FILE=~/.ssh/mc2026/mcp-agent-mcperu-rsa
# Opcional para claves cifradas. Preferible desbloquear la clave con ssh-agent.
MCP_WEB_SSH_KEY_PASSPHRASE=
MCP_WEB_SSH_ALLOW_AGENT=0
# Solo para bootstrap administrativo por MCP; mantener en 0 para operacion normal.
MCP_WEB_SSH_ENABLE_PASSWORD=0
# CentOS/OpenSSH antiguos pueden requerir firma ssh-rsa para llaves RSA.
MCP_WEB_SSH_FORCE_SSH_RSA=0

MCP_WEB_DB_HOST=127.0.0.1
MCP_WEB_DB_PORT=3306
MCP_WEB_DB_NAME=bdmcperu
MCP_WEB_DB_USER=mcp_agent_ro
MCP_WEB_DB_PASSWORD=

MCP_WEB_ALLOWED_ROOTS=/var/www,/home/mcp-agent/apps,/usr/local/apache/htdocs,/usr/share/nginx/html
MCP_WEB_MAX_READ_BYTES=100000
